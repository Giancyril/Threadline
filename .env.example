# LLM Providers (Configure at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Primary Models
CHAT_MODEL=gpt-4o-mini
EXTRACTION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector Storage (qdrant / local / memory)
VECTOR_STORE_PROVIDER=qdrant
QDRANT_LOCATION=local_storage/qdrant

# Database
DATABASE_URL=sqlite+aiosqlite:///./assistant_memory.db

# App Settings
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:5173
